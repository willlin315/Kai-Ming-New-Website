"/* Loaded after the retained page CSS so fixed Wix geometry cannot win. */\n.km-mobile-header { display:none; }\n.km-responsive .km-desktop-header { display:contents; }\n@media (max-width:1000px) {\n  html, body { min-width:0!important; width:100%!important; margin:0; }\n  .km-responsive { --site-width:100%; --site-width-root:100%; --minViewportSize:0px; width:100%; }\n  .km-responsive *, .km-responsive *::before, .km-responsive *::after { box-sizing:border-box; }\n  .km-responsive #SITE_CONTAINER, .km-responsive #main_MF, .km-responsive #site-root,\n  .km-responsive #masterPage, .km-responsive #PAGES_CONTAINER, .km-responsive #SITE_PAGES,\n  .km-responsive #SITE_PAGES_TRANSITION_GROUP, .km-responsive #SITE_FOOTER,\n  .km-responsive .wixui-page, .km-responsive [id^=\"Container\"], .km-responsive .km-news-page {\n    width:100%!important; min-width:0!important; max-width:100%!important;\n    height:auto!important; min-height:0!important; margin:0!important; left:auto!important;\n  }\n  .km-responsive #masterPage { display:flex!important; flex-direction:column; }\n  .km-responsive #PAGES_CONTAINER, .km-responsive #SITE_FOOTER { position:relative!important; top:auto!important; }\n  .km-responsive #SITE_HEADER { position:relative!important; width:100%!important; min-width:0!important; height:auto!important; min-height:0!important; top:auto!important; margin:0!important; }\n  .km-responsive .km-desktop-header { display:none!important; }\n  .km-responsive .km-mobile-header { display:block; background:white; color:#0f4d6b; font:16px/1.5 Arial,sans-serif; border-bottom:1px solid #e3e8ec; }\n  .km-responsive .km-mobile-bar { display:flex; align-items:center; gap:16px; max-width:960px; margin:auto; padding:12px 20px; }\n  .km-responsive .km-mobile-bar img { display:block; object-fit:contain; width:60px; height:60px; }\n  .km-responsive .km-mobile-apply { margin-left:auto; padding:10px 16px; background:#0f4d6b; color:white; text-decoration:none; border-radius:4px; }\n  .km-responsive .km-mobile-bar button { min-width:44px; min-height:44px; border:1px solid #cad5da; border-radius:4px; color:#0f4d6b; background:white; font-size:26px; cursor:pointer; }\n  .km-responsive .km-mobile-header nav { padding:0 20px 20px; max-width:960px; margin:auto; }\n  .km-responsive .km-mobile-header nav[hidden] { display:none!important; }\n  .km-responsive .km-mobile-header summary { padding:12px 0; cursor:pointer; font-weight:bold; border-bottom:1px solid #e3e8ec; }\n  .km-responsive .km-mobile-header nav a { display:block; padding:12px 16px; min-height:44px; color:#0f4d6b; text-decoration:none; }\n  .km-responsive .km-mobile-header a:focus-visible, .km-responsive .km-mobile-header button:focus-visible, .km-responsive .km-mobile-header summary:focus-visible { outline:2px solid #0f4d6b; outline-offset:3px; }\n  .km-responsive .wixui-section, .km-responsive .wixui-column-strip,\n  .km-responsive .wixui-column-strip__column, .km-responsive .wixui-repeater__item {\n    position:relative!important; inset:auto!important; min-width:0!important; max-width:100%!important;\n    width:100%!important; height:auto!important; min-height:0!important; margin:0!important;\n    flex:initial!important; --column-width:100%; --column-flex:1;\n  }\n  .km-responsive .wixui-section { padding:32px 24px!important; }\n  .km-responsive .wixui-column-strip [data-testid=\"columns\"] { display:flex!important; flex-direction:column!important; gap:24px; min-width:0!important; width:100%!important; padding:0!important; }\n  .km-responsive [data-testid=\"inline-content\"], .km-responsive [data-testid=\"mesh-container-content\"] {\n    width:100%!important; min-width:0!important; max-width:100%!important; height:auto!important; min-height:0!important;\n  }\n  .km-responsive [data-testid=\"mesh-container-content\"] {\n    display:flex!important; flex-direction:column!important; gap:20px; grid-template-columns:none!important; grid-template-rows:none!important;\n    padding:0!important; margin:0