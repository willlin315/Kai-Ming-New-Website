ortant; }\n  .km-responsive .km-gallery-photo { width:100%; height:100%; min-height:0; object-fit:cover; }\n  .km-responsive .km-gallery-controls { gap:6px; max-width:calc(100% - 24px); white-space:nowrap; bottom:12px; }\n  .km-responsive .km-gallery-controls button { min-height:36px; }\n  .km-responsive .wixui-google-map { height:280px!important; }\n  .km-responsive iframe { max-width:100%!important; width:100%!important; }\n  .km-responsive .wixui-google-map iframe { height:280px!important; }\n  .km-responsive .wixui-repeater, .km-responsive .wixui-repeater > div { width:100%!important; min-width:0!important; height:auto!important; }\n  .km-responsive fluid-columns-repeater { display:grid!important; grid-template-columns:repeat(2,minmax(0,1fr))!important; gap:28px!important; width:100%!important; min-width:0!important; }\n  .km-responsive .wixui-repeater__item { padding:20px!important; }\n  .km-responsive .wixui-repeater__item .wixui-image { max-width:280px!important; align-self:center!important; }\n  .km-responsive .wixui-repeater__item [data-testid=\"mesh-container-content\"] { gap:12px; }\n  .km-responsive .wixui-tabs, .km-responsive .wixui-tabs__container, .km-responsive [role=\"tabpanel\"], .km-responsive [role=\"tabpanel\"] > div {\n    width:100%!important; max-width:100%!important; min-width:0!important; height:auto!important; min-height:0!important; position:relative!important; inset:auto!important;\n  }\n  .km-responsive .wixui-tabs__menu-container { width:100%!important; min-width:0!important; height:auto!important; position:relative!important; margin:0 0 24px!important; }\n  .km-responsive [role=\"tablist\"] { display:flex!important; width:100%!important; min-width:0!important; height:auto!important; flex-wrap:wrap; gap:8px; }\n  .km-responsive [role=\"tab\"] { flex:1 1 140px!important; width:auto!important; max-width:100%!important; height:auto!important; min-height:48px!important; padding:12px 16px!important; white-space:normal!important; text-align:center!important; }\n  .km-responsive [role=\"tab\"] > * { white-space:normal!important; height:auto!important; width:auto!important; position:relative!important; }\n  .km-responsive [role=\"tabpanel\"][hidden] { display:none!important; }\n  .km-responsive form, .km-responsive fieldset, .km-responsive [data-hook=\"Form-wrapper\"], .km-responsive [data-hook=\"form-root\"] {\n    width:100%!important; min-width:0!important; max-width:100%!important; height:auto!important; padding:0!important; margin:0!important;\n  }\n  .km-responsive form [style*=\"grid-template-columns\"] { display:grid!important; grid-template-columns:minmax(0,1fr)!important; grid-auto-rows:auto!important; gap:0 5px!important; }\n  /* Stack every label row and field in one full-width column, as the Wix mobile form does. */\n  .km-responsive form [style*=\"grid-template-columns\"] > * { grid-column:1 / -1!important; grid-row:auto!important; min-width:0!important; max-width:100%!important; }\n  .km-responsive form input:not([type=\"checkbox\"]):not([type=\"radio\"]), .km-responsive form textarea, .km-responsive form select { font-size:16px!important; max-width:100%!important; min-width:0!important; }\n  .km-responsive .km-form-dropdown { text-overflow:ellipsis; }\n  .km-responsive form label { white-space:normal!important; }\n  .km-responsive .wixui-button { min-height:44px; max-width:100%!important; }\n  .km-responsive .wixui-button a, .km-responsive .wixui-button button { min-height:44px; white-space:normal!important; }\n  .km-responsive #SITE_FOOTER { padding:32px 24px!important; }\n  .km-responsive #SITE_FOOTER .wixui-section { padding:0!important; }\n  .km-responsive #SITE_FOOTER [data-testid=\"columns\"] { flex-direction:column!important; }\n  .km-responsive .km-news-page { padding:32px 24px!important; }\n  .km-responsive .km-news-card { grid-template-columns:minmax(0,1fr)!important; }\n  .km-responsive .km-news-card img { height:auto!important; aspect-ratio:4/3; object-fit:cover; }\n  .km-responsive .km-news-card-content { padding:24px!important; }\n}\n@media (max-width:600px) {\n  .km-responsive .wixui-section { padding:28px 20px!important; }\n  .km-responsive fluid-columns-repeater { grid-template-columns:minmax(0,1fr)!important; }\n  .km-responsive .km-gallery-controls { font-size:13px; }\n}\n\n/* Center images within the four-card backplates; leave other repeaters alone. */\n@media (min-width:1001px) {\n  .km-responsive .km-four-card-layout[data-testid=\"mesh-container-content\"] {\n    box-sizing:border-box; padding:24px; gap:20px 16px;\n    grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);\n    grid-template-rows:auto 1fr; align-items:start;\n  }\n  .km-responsive .km-four-card-layout[data-testid] > .wixui-image {\n    grid-area:1 / 1 / 3 / 2; align-self:center; justify-self:center;\n    margin:0; left:auto; width:100%; max-width:210px;\n    height:auto; aspect-ratio:210 / 344;\n  }\n  .km-responsive .km-four-card-layout[data-testid] > .wixui-image > div,\n  .km-responsive .km-four-card-layout[data-testid] > .wixui-image > a {\n    display:block; width:100%; height:100%;\n  }\n  .km-responsive .km-four-card-layout[data-testid] > .wixui-image img {\n    display:block; width:100%; height:100%; object-fit:cover; object-position:center;\n  }\n  .km-responsive .km-four-card-layout[data-testid] > .wixui-rich-text {\n    margin:0; left:auto; width:100%; min-width:0; justify-self:stretch;\n  }\n  .km-responsive .km-four-card-layout[data-testid] > .wixui-rich-text:nth-child(2) {\n    grid-area:1 / 2 / 2 / 3;\n  }\n  .km-responsive .km-four-card-layout[data-testid] > .wixui-rich-text:nth-child(3) {\n    grid-area:2 / 2 / 3 / 3;\n  }\n}\n"