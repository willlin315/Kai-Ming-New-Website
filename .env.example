# Public website origin (no trailing slash). Used for canonical/hreflang URLs, sitemap and share links.
# Change to https://www.kaiming.org at launch.
SITE_URL=https://kai-ming-new-website.vercel.app
# Leave empty when hosted at a domain root. Only set for sub-path hosting.
NEXT_PUBLIC_BASE_PATH=
# CMS (server-only; never prefix these with NEXT_PUBLIC_).
# SQLite database file. Railway: /data/cms.sqlite on the mounted volume. Local: .cms-data/cms.sqlite
CMS_DATABASE_PATH=
# Shared editor token for /admin, at least 32 characters.
CMS_DEV_TOKEN=
# The CMS refuses to run unless this is "development".
CMS_ENV=development
# Set to true only for the production launch build to allow search engine indexing.
SITE_INDEXABLE=false
